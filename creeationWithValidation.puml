@startuml
title Алгоритм создания рейса (FlightManagementServiceImpl.createFlight)

start
:Ввод номера рейса, даты вылета, типа ВС, бортового номера;
:Нормализация: trim(), верхний регистр;

if (Номер рейса пуст?) then (да)
  :Ошибка: "Введите номер рейса";
  stop
endif

if (Дата вылета в прошлом?) then (да)
  :Ошибка: "Дата вылета не может быть в прошлом";
  stop
endif

:Открыть транзакцию;
if (Борт с таким номером\nнайден в парке?) then (да)
  if (Тип борта совпадает\nс типом рейса?) then (нет)
    :Ошибка: "Тип рейса не совпадает с типом борта";
    stop
  endif
  if (Номер рейса уже существует?) then (да)
    :Ошибка: "Рейс с таким номером уже существует";
    stop
  endif
  :Создать Flight со статусом SCHEDULED;
  :Связать рейс с бортом;
  :Сохранить в БД, зафиксировать транзакцию;
  :Успех: рейс создан;
  stop
else (нет)
  :Ошибка: "Борт не найден в парке";
  stop
endif
@enduml
