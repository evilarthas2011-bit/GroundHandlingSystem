@startuml
skinparam dpi 300
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
left to right direction

package "com.kuleshov.groundhandling.domain" {

  class Flight <<Entity>> {
    - id : Long
    - flightNumber : String
    - departureDateTime : LocalDateTime
    - passengerWeight : Double
    - status : FlightStatus
    + getTotalCargoWeight() : double
    + getTotalWeight() : double
    + isClosedForOperations() : boolean
    + addCargo(cargo : Cargo)
    + removeCargo(cargo : Cargo)
  }

  class Aircraft <<Entity>> {
    - id : Long
    - tailNumber : String
    + getMaxPayload() : double
    + {static} createFor(type : AircraftType, tail : String) : Aircraft
  }

  class Compartment <<Entity>> {
    - id : Long
    - name : String
    - maxWeight : double
    - currentWeight : double
    + getLoadRatio() : double
  }

  class Cargo <<Entity>> {
    - id : Long
    - description : String
    - weight : double
    - addedAt : LocalDateTime
  }

  abstract class Resource <<Entity>> {
    - id : Long
    - assignedFlight : Flight
    + isFree() : boolean
  }

  class Equipment {
    - modelName : String
  }

  class Brigade {
    - specialization : String
    - size : int
  }

  enum FlightStatus {
    SCHEDULED
    ARRIVED
    LOADING
    BOARDING
    READY
    DEPARTED
    DELAYED
  }

  enum AircraftType {
    - displayName : String
    - compartments : List<CompartmentSpec>
    + getDisplayName() : String
    + getCompartments() : List<CompartmentSpec>
  }

  class CompartmentSpec {
    - name : String
    - maxWeight : double
  }
}

package "com.kuleshov.groundhandling.repository" {

  interface FlightRepository {
    + findAll() : List<Flight>
    + findByIdWithDetails(session : Session, id : Long) : Flight
    + save(session : Session, flight : Flight)
    + delete(session : Session, id : Long)
  }

  interface AircraftRepository {
    + findByTailNumber(session : Session, tail : String) : Aircraft
    + findAll() : List<Aircraft>
    + save(session : Session, aircraft : Aircraft)
  }

  interface ResourceRepository {
    + findAll() : List<Resource>
    + findAvailableEquipment() : List<Equipment>
    + findAvailableBrigades() : List<Brigade>
    + save(resource : Resource)
  }

  class FlightRepositoryImpl
  class AircraftRepositoryImpl
  class ResourceRepositoryImpl
}

package "com.kuleshov.groundhandling.service" {

  interface FlightManagementService {
    + createFlight(number : String, departure : LocalDateTime,
        type : AircraftType, tail : String) : OperationResult
    + addCargoToFlight(flightId : Long, compartmentId : Long,
        weight : double, description : String) : OperationResult
    + unloadLastCargoFromFlight(flightId : Long,
        compartmentId : Long) : OperationResult
    + updatePassengerWeight(flightId : Long, weight : double) : OperationResult
    + updateFlightStatus(flightId : Long, status : FlightStatus) : OperationResult
    + assignResources(flightId : Long, equipmentId : Long,
        brigadeId : Long) : OperationResult
    + deleteFlight(flightId : Long) : OperationResult
    + getAssignedResources(flight : Flight) : List<Resource>
  }

  interface ResourceManagementService {
    + addEquipment(modelName : String) : OperationResult
    + addBrigade(specialization : String, size : int) : OperationResult
    + freeResource(resourceId : Long) : OperationResult
    + deleteResource(resourceId : Long) : OperationResult
  }

  interface FleetManagementService {
    + registerAircraft(type : AircraftType, tailNumber : String) : OperationResult
    + getFleet() : List<Aircraft>
  }

  class FlightManagementServiceImpl {
    - weightBalanceService : WeightBalanceService
  }
  class ResourceManagementServiceImpl
  class FleetManagementServiceImpl

  class WeightBalanceService {
    + validateAndAddCargo(flight : Flight, cargo : Cargo) : boolean
    + unloadLastCargo(flight : Flight, compartment : Compartment) : boolean
  }

  class ResourceAllocationService {
    + allocateResources(flightId : Long) : OperationResult
  }

  class FlightStatusTransitionValidator {
    + validate(current : FlightStatus, next : FlightStatus) : OperationResult
  }

  class OperationResult <<Value Object>> {
    - success : boolean
    - message : String
    + isSuccess() : boolean
    + getMessage() : String
    + {static} success(message : String) : OperationResult
    + {static} error(message : String) : OperationResult
  }
}

package "com.kuleshov.groundhandling.controller" {

  class DashboardController {
    - selectedFlight : Flight
    - flightManagementService : FlightManagementService
    - allocationService : ResourceAllocationService
    - startAutoRefresh()
    - loadFlights()
    - showFlightDetails(flight : Flight)
    - handleAddCargo()
    - handleExportCsv()
  }

  class FlightFormController
  class FleetViewController
  class ResourcesController
}

package "com.kuleshov.groundhandling" {

  class MainApp
  class HibernateUtil <<Singleton>> {
    - {static} sessionFactory : SessionFactory
    - {static} CFG_FILE : String
    + {static} getSessionFactory() : SessionFactory
    + {static} inSession(work : Function) : T
    + {static} inTransaction(work : Function) : T
  }

  class CSVExporter {
    + {static} exportFlights(flights : List<Flight>, path : String)
  }
}

' --- доменные связи ---
Flight "1" *-- "0..*" Cargo : cargoList
Flight "0..*" --> "1" Aircraft : aircraft
Aircraft "1" *-- "0..*" Compartment : compartments
Compartment "1" *-- "0..*" Cargo : cargoList
Aircraft --> AircraftType : aircraftType
AircraftType "1" o-- "2" CompartmentSpec
Resource <|-- Equipment
Resource <|-- Brigade
Resource "0..*" --> "0..1" Flight : assignedFlight

' --- репозитории ---
FlightRepositoryImpl ..|> FlightRepository
AircraftRepositoryImpl ..|> AircraftRepository
ResourceRepositoryImpl ..|> ResourceRepository
FlightRepositoryImpl ..> HibernateUtil
AircraftRepositoryImpl ..> HibernateUtil
ResourceRepositoryImpl ..> HibernateUtil

' --- сервисы ---
FlightManagementServiceImpl ..|> FlightManagementService
ResourceManagementServiceImpl ..|> ResourceManagementService
FleetManagementServiceImpl ..|> FleetManagementService
FlightManagementServiceImpl --> FlightRepository
FlightManagementServiceImpl --> AircraftRepository
FlightManagementServiceImpl --> ResourceRepository
FlightManagementServiceImpl --> WeightBalanceService
FlightManagementServiceImpl --> FlightStatusTransitionValidator
ResourceManagementServiceImpl --> ResourceRepository
FleetManagementServiceImpl --> AircraftRepository
ResourceAllocationService --> ResourceRepository

' --- контроллер ---
DashboardController --> FlightManagementService
DashboardController --> ResourceAllocationService
DashboardController ..> CSVExporter
FlightFormController --> FlightManagementService
FleetViewController --> FleetManagementService
ResourcesController --> ResourceManagementService

MainApp ..> HibernateUtil

' --- использование сущностей domain ---
FlightManagementServiceImpl --> Flight
FlightManagementServiceImpl --> Cargo
WeightBalanceService --> Flight
WeightBalanceService --> Cargo
WeightBalanceService --> Compartment
ResourceAllocationService --> Resource
ResourceRepositoryImpl --> Resource
DashboardController --> Flight
DashboardController --> OperationResult
HibernateUtil --> Flight
HibernateUtil --> Aircraft
HibernateUtil --> Compartment
HibernateUtil --> Cargo
HibernateUtil --> Equipment
HibernateUtil --> Brigade
@enduml
