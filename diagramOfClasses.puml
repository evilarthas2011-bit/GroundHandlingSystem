@startuml
!pragma layout smetana
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 45
skinparam package {
  BackgroundColor #F8F9FA
  BorderColor #9AA5B1
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #53627C
  ArrowColor #53627C
}
hide circle
hide empty methods

' ================= ДОМЕН (нижний слой, ни от кого не зависит) =================
package "domain" as Domain {

  enum FlightStatus {
    SCHEDULED
    ARRIVED
    LOADING
    BOARDING
    READY
    DELAYED
    DEPARTED
  }

  enum AircraftType {
    BOEING_737
    AIRBUS_A320
    +getDisplayName() String
    +getMaxPayload() double
  }

  class Aircraft {
    -id : Long
    -tailNumber : String
    -aircraftType : AircraftType
    -compartments : List~Compartment~
    +getMaxPayload() double
    +{static} createFor(type, tail) Aircraft
  }

  class Compartment {
    -id : Long
    -name : String
    -maxWeight : double
    -currentWeight : double
    -aircraft : Aircraft
  }

  class Flight {
    -id : Long
    -flightNumber : String
    -departureDateTime : LocalDateTime
    -status : FlightStatus
    -passengerWeight : Double
    -cargoList : List~Cargo~
    -aircraft : Aircraft
    +getTotalCargoWeight() double
    +getTotalWeight() double
    +isClosedForOperations() boolean
    +addCargo(cargo) void
    +removeCargo(cargo) void
  }

  class Cargo {
    -id : Long
    -weight : double
    -description : String
    -addedAt : LocalDateTime
    -flight : Flight
    -compartment : Compartment
  }

  abstract class Resource {
    -id : Long
    -name : String
    -assignedFlight : Flight
    +isFree() boolean
  }

  class Equipment {
  }

  class Brigade {
    -size : int
  }

  Resource <|-- Equipment
  Resource <|-- Brigade
  Flight "1" --> "1" FlightStatus
  Flight "*" --o "1" Aircraft : назначен борт
  Aircraft "1" *-- "2" Compartment : отсеки
  Aircraft "1" --> "1" AircraftType
  Flight "1" *-- "*" Cargo : грузы
  Cargo "*" --> "1" Compartment : размещён в
  Resource "*" --> "0..1" Flight : назначен на
}

' ================= РЕПОЗИТОРИИ =================
package "repository" as Repo {

  interface FlightRepository {
    +findAll() List~Flight~
    +findById(id) Flight
    +findByIdWithDetails(id) Flight
    +findByFlightNumber(number) Flight
    +save(flight) void
    +delete(flight) void
  }

  interface AircraftRepository {
    +findAll() List~Aircraft~
    +findByTailNumber(number) Aircraft
    +save(aircraft) void
  }

  interface ResourceRepository {
    +findAll() List~Resource~
    +findByAssignedFlight(flight) List~Resource~
    +findAvailableEquipment() List~Equipment~
    +findAvailableBrigades() List~Brigade~
    +save(resource) void
    +delete(resource) void
    +release(resourceId) void
  }

  class FlightRepositoryImpl
  class AircraftRepositoryImpl
  class ResourceRepositoryImpl

  FlightRepositoryImpl ..|> FlightRepository
  AircraftRepositoryImpl ..|> AircraftRepository
  ResourceRepositoryImpl ..|> ResourceRepository
}

' ================= СЕРВИСЫ =================
package "service" as Svc {

  interface FlightManagementService {
    +createFlight(number, dateTime, type, tail) OperationResult
    +updateFlightStatus(id, status) OperationResult
    +updatePassengerWeight(id, weight) OperationResult
    +addCargoToFlight(id, compartmentId, weight, desc) OperationResult
    +unloadLastCargoFromFlight(id, compartmentId) OperationResult
    +assignResources(id, equipmentId, brigadeId) OperationResult
    +deleteFlight(id) OperationResult
  }

  interface ResourceManagementService {
    +addEquipment(name) OperationResult
    +addBrigade(name, size) OperationResult
    +freeResource(resourceId) OperationResult
    +deleteResource(resourceId) OperationResult
  }

  class FleetManagementService {
    +registerAircraft(type, tail) OperationResult
    +getFleet() List~Aircraft~
  }

  class ResourceAllocationService {
    +allocateResources(flightId) OperationResult
  }

  class FlightManagementServiceImpl {
    -flightRepository : FlightRepository
    -resourceRepository : ResourceRepository
    -aircraftRepository : AircraftRepository
    -weightBalanceService : WeightBalanceService
  }
  class ResourceManagementServiceImpl

  class WeightBalanceService {
    +validateAndAddCargo(flight, cargo) boolean
    +unloadLastCargo(flight, compartment) boolean
  }

  class OperationResult {
    -success : boolean
    -message : String
    +{static} success(msg) OperationResult
    +{static} error(msg) OperationResult
    +isSuccess() boolean
    +getMessage() String
  }

  FlightManagementServiceImpl ..|> FlightManagementService
  ResourceManagementServiceImpl ..|> ResourceManagementService
  FlightManagementServiceImpl o-- WeightBalanceService
}

' ================= КОНТРОЛЛЕРЫ =================
package "controller" as Ctrl {

  class MainApp {
    -primaryStage : Stage
    +{static} getPrimaryStage() Stage
    +start(stage) void
  }

  class DashboardController {
    -selectedFlight : Flight
    -equipmentByFlightId : Map~Long,Equipment~
    -brigadeByFlightId : Map~Long,Brigade~
    -updatingStatus : boolean
    +loadFlights() void
    +showFlightDetails(flight) void
    +showFleetView() void
    +switchToFlights() void
    +switchToResources() void
  }

  class FlightFormController {
    -onFlightCreated : Runnable
    +handleCreateFlight() void
  }

  class FleetViewController {
    -onFleetChanged : Runnable
    +handleAddAircraft() void
  }

  MainApp o-- DashboardController
}

' ================= УТИЛИТЫ =================
package "util" as Util {
  class HibernateUtil {
    -{static} sessionFactory : SessionFactory
    +{static} getSessionFactory() SessionFactory
    +{static} inSession(fn) T
    +{static} inTransaction(fn) T
  }
  class CSVExporter {
    +{static} exportFlights(flights, path) void
  }
  class DemoDataInitializer {
    +{static} initialize() void
  }
}

' ---------- зависимости слоёв (пакетные стрелки) ----------
Ctrl ..> Svc : вызовы сервисов
Svc ..> Repo : доступ к данным
Svc ..> Domain : сущности
Repo ..> Domain : ORM-маппинг
Ctrl ..> Domain : модели таблиц и экспорт
Repo ..> Util : HibernateUtil
Svc ..> Util : транзакции
Ctrl ..> Util : CSV, демо-данные

@enduml
